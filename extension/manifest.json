{
  "manifest_version": 3,
  "name": "Conceptual Learning Assistant",
  "version": "0.1.0",
  "description": "Understand why a problem works, not just how to solve it.",
  "permissions": ["sidePanel", "activeTab", "scripting"],
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open Learning Assistant" }
}
